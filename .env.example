# Plantilla de variables de entorno. Copia este archivo como .env y pon tus valores.
# Nunca subas el archivo .env al repositorio (está en .gitignore).
# Estas variables las usará la capa web (Flask) y la de datos (SQLite) según el ADR-001.

# Clave para firmar la sesión de Flask. Genera una con:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia-esta-clave

# Ruta del archivo de la base de datos SQLite
RUTA_BD=inventario.sqlite3
